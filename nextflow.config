/*
========================================================================================
Nextflow config file for running on AWS Batch
========================================================================================
*/

params.environment = 'uat'
params.account_id = '952995844145'
params.s3_bucket = "s3://reference-${params.environment}-${params.account_id}"
// not sure what this is used for???
params.ecr_registry = "${params.account_id}.dkr.ecr.eu-west-2.amazonaws.com"

podman.enabled = true

env {
    AWS_ENDPOINT_URL_S3 = "https://s3.dualstack.eu-west-2.amazonaws.com"
}

process {

    executor = 'awsbatch'

    // default container
    container = "${params.ecr_registry}/pipeline_containers/ghcr.io/tso500_post_processing:dev_aws"

    // tso500 app container
    withLabel: app_container {
        container = "952995844145.dkr.ecr.eu-west-2.amazonaws.com/pipeline_containers/tso500_app:ruo-2.2.0.12_custom_entrypoint_aws"
    }

    // samtools container
    withLabel: samtools_container {
        container = "${params.ecr_registry}/pipeline_containers/community.wave.seqera.io/samtools:1.21--0d76da7c3cf7751c"
    }

    // fastqc container
    withLabel: fastqc_container {
        container = "${params.ecr_registry}/pipeline_containers/community.wave.seqera.io/fastqc:0.11.9--fd0125189547cb9c"
    }

    // default queue
    queue = "${params.environment}-batch-job-queue"

    withLabel: demultiplex_queue {
        queue = "${params.environment}-batch-demultiplexing-queue"
    }
}

aws {
    batch {
        // NOTE: this setting is only required if the AWS CLI is installed in a custom AMI
        // cliPath = '/opt/conda-env/bin/aws'

        maxTransferAttempts = 3
        delayBetweenAttempts = '20 sec'

        // Lower I/O load to try and prevent failures with multiple jobs
        // on a single instance
        maxParallelTransfers = 4

        
    }
    region = 'eu-west-2'
}
